<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.dafi.desktop.adapters.inbound.fx.ClientsController"
      VBox.vgrow="ALWAYS">

    <VBox spacing="5" styleClass="section-header">
        <HBox alignment="TOP_LEFT" spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="clientsTitle" styleClass="section-title"/>
                <Label fx:id="clientsSubtitle" styleClass="section-subtitle"/>
            </VBox>
            <Button fx:id="keyToolsButton" onAction="#showKeyToolsMenu"
                    styleClass="add-button" text="&#x1F527;"/>
        </HBox>
    </VBox>

    <HBox spacing="15" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
        <padding>
            <Insets top="0" right="0" bottom="20" left="0"/>
        </padding>

        <Button fx:id="newClientButton" onAction="#handleNewClient" styleClass="add-button"/>
        <Button fx:id="bulkLoadButton" onAction="#handleBulkLoad" styleClass="add-button"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">

        <!-- Tabla de clientes -->
        <VBox fx:id="tableContainer" spacing="10">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10" VBox.vgrow="NEVER">
                <TextField fx:id="searchField" styleClass="search-field"
                           promptText="" prefWidth="350" prefHeight="36"/>
                <ProgressIndicator fx:id="searchSpinner" prefWidth="20" prefHeight="20"
                                   visible="false" managed="false"/>
                <Label fx:id="searchResultsLabel" styleClass="status-label"/>
            </HBox>

            <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="folioColumn" prefWidth="100"/>
                    <TableColumn fx:id="nameColumn" prefWidth="180"/>
                    <TableColumn fx:id="vencimientoColumn" prefWidth="110"/>
                    <TableColumn fx:id="contractTypeColumn" prefWidth="100"/>
                    <TableColumn fx:id="phoneColumn" prefWidth="100"/>
                    <TableColumn fx:id="neighborhoodColumn" prefWidth="120"/>
                    <TableColumn fx:id="paymentMethodColumn" prefWidth="100"/>
                    <TableColumn fx:id="contractDateColumn" prefWidth="100"/>
                    <TableColumn fx:id="totalPaymentsColumn" prefWidth="80"/>
                    <TableColumn fx:id="monthlyPaymentColumn" prefWidth="100"/>
                    <TableColumn fx:id="totalBalanceColumn" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Formulario de nuevo cliente -->
        <fx:include fx:id="clientForm" source="ClientFormView.fxml"/>

    </StackPane>

    <Label fx:id="loadingLabel" visible="false" styleClass="loading-label"/>
</VBox>
