<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.davichus1303.DAFI_desktop</id>
  <name>DAFI Desktop</name>
  <summary>Client management system for a funeral services firm</summary>
  <summary xml:lang="es">Sistema de administración de clientes para despacho funerario</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      DAFI Desktop is a desktop application for managing the clients of a
      funeral services firm. It keeps contract information, client records,
      contract types and payment methods, and supports bulk imports from
      Excel spreadsheets.
    </p>
    <p>
      All data is stored locally in encrypted JSON files under the XDG data
      directory; the password is hashed with Argon2id and the encryption key
      is kept in the operating system credential vault.
    </p>
    <p>
      Local encrypted storage (AES-256-GCM). Secure authentication with
      Argon2id. Bulk client import from Excel with validation and error
      report. Real-time search with debounce. Internationalization in Spanish.
    </p>
    <p>**This app is only available in Spanish.**</p>
  </description>

